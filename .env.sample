# Ollama (local inference server)
OLLAMA_BASE_URL=http://localhost:11434
# Vision-language model (text + images). Swap here to experiment; the ollama
# container pulls it on next `docker compose up -d`.
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=120

# Shared secret: the main backend must send X-API-Key with this value.
API_KEY=change-me
