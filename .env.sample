# llama.cpp server (OpenAI-compatible /v1 API), model on the AMD iGPU via Vulkan.
# Base URL is overridden to http://llamacpp:8000 inside docker-compose.
LLAMACPP_BASE_URL=http://localhost:8080
# Label reported to callers (the actual weights come from LLAMACPP_MODEL_FILE).
LLAMACPP_MODEL=gemma-4-26b-a4b
LLAMACPP_TIMEOUT_SECONDS=180

# GGUF filename served from ./models (pre-download it there, see README). This
# MoE (26B total, ~4B active) is a QAT Q4 build ~14 GB and fits the 16 GB iGPU
# VRAM carveout. Its thinking mode is disabled in docker-compose
# (--reasoning-budget 0) — leave it on and generation takes ~150 s/exercise.
#   wget -c -P models https://huggingface.co/unsloth/gemma-4-26B-A4B-it-qat-GGUF/resolve/main/gemma-4-26B-A4B-it-qat-UD-Q4_K_XL.gguf
LLAMACPP_MODEL_FILE=gemma-4-26B-A4B-it-qat-UD-Q4_K_XL.gguf
# Context window (KV cache also lives in VRAM; bigger = more VRAM).
LLAMACPP_CONTEXT=8192

# Shared secret: the main backend must send X-API-Key with this value.
API_KEY=change-me
